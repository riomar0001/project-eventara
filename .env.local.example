# ============================================================
# Eventara — Local Development Environment
# Copy to .env inside server/ and client/ as needed.
# These values work with: docker compose -f server/docker-compose.db.yml up -d
# ============================================================

# ─────────────────────────────────────────────────────────
# Server (server/.env)
# ─────────────────────────────────────────────────────────
APP_NAME=Eventara
DEBUG=True
HOST=0.0.0.0
PORT=8000

# ─────────────────────────────────────────────────────────
# PostgreSQL (used by the postgres service and DATABASE_URL)
# ─────────────────────────────────────────────────────────
POSTGRES_USER=eventara
POSTGRES_PASSWORD=TODO_strong_password
POSTGRES_DB=eventara_db

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/eventara_db

SECRET_KEY=local_secret_key_not_for_production
JWT_ACCESS_TOKEN_SECRET=local_access_secret
JWT_REFRESH_TOKEN_SECRET=local_refresh_secret
JWT_VERIFICATION_TOKEN_SECRET=local_verification_secret
ADMISSION_TOKEN_SECRET=local_admission_secret

ACCESS_TOKEN_EXPIRATION=3h
REFRESH_TOKEN_EXPIRATION=7d
VERIFICATION_TOKEN_EXPIRATION=24h

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=password

MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER="inguitomario00@gmail.com"
MAIL_PASS="dezb qtqo fber yvce"

CORS_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

ADMIN_EMAIL=admin@local.dev
ADMIN_PASSWORD=admin123

# Storage is optional for local dev — leave blank to disable
STORAGE_ENDPOINT="https://b8d3ac74f68e959d2c02abaff44dd65f.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID="ea9e14030188a23f747547c019103194"
STORAGE_SECRET_ACCESS_KEY="20b1f8ddfa6b9548f508f55d7ab192c605131bf2cbb335056eed1ff6522c67bb"
STORAGE_BUCKET_NAME="eventara-bucket"
STORAGE_PUBLIC_URL="https://pub-0bda9597a40f4d1a9864eaa065d54b4a.r2.dev"

# ─────────────────────────────────────────────────────────
# Client (client/.env)
# ─────────────────────────────────────────────────────────
# Points Next.js rewrites to the local FastAPI server
API_URL=http://127.0.0.1:8000

# Leave blank if storage is not configured locally
NEXT_PUBLIC_STORAGE_PUBLIC_URL=
