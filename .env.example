# ============================================================
# Eventara — Production Environment Variables
# Copy this file to .env and fill in every value marked TODO.
# NEVER commit .env to version control.
# ============================================================

# ─────────────────────────────────────────────────────────
# PostgreSQL (used by the postgres service and DATABASE_URL)
# ─────────────────────────────────────────────────────────
POSTGRES_USER=eventara
POSTGRES_PASSWORD=TODO_strong_password
POSTGRES_DB=eventara_db

# ─────────────────────────────────────────────────────────
# Server — FastAPI
# ─────────────────────────────────────────────────────────
APP_NAME=Eventara
DEBUG=False

# Must use the postgres service name as the host
DATABASE_URL=postgresql+asyncpg://eventara:TODO_strong_password@postgres:5432/eventara_db

# Generate each secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=TODO
JWT_ACCESS_TOKEN_SECRET=TODO
JWT_REFRESH_TOKEN_SECRET=TODO
JWT_VERIFICATION_TOKEN_SECRET=TODO
ADMISSION_TOKEN_SECRET=TODO

# Token lifetimes
ACCESS_TOKEN_EXPIRATION=3h
REFRESH_TOKEN_EXPIRATION=7d
VERIFICATION_TOKEN_EXPIRATION=24h

# Redis — must use the redis service name as the host
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=TODO_strong_redis_password

# SMTP / Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=False
MAIL_USER=TODO_your_email@gmail.com
MAIL_PASS=TODO_your_app_password

# CORS_ORIGIN  — single URL used in email links (verify, reset-password, etc.)
# ALLOWED_ORIGINS — comma-separated list of origins the API accepts requests from.
#   Single:   ALLOWED_ORIGINS=https://eventara.com
#   Multiple: ALLOWED_ORIGINS=https://eventara.com,https://www.eventara.com,https://admin.eventara.com
CORS_ORIGIN=https://eventara.com
ALLOWED_ORIGINS=https://eventara.com,https://www.eventara.com

# Seed admin account (created on first startup)
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=TODO_strong_admin_password

# Object Storage — Cloudflare R2 / AWS S3 / MinIO (all optional)
STORAGE_ENDPOINT=https://TODO_account_id.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=TODO
STORAGE_SECRET_ACCESS_KEY=TODO
STORAGE_BUCKET_NAME=eventara-bucket
STORAGE_PUBLIC_URL=https://TODO.r2.dev

# ─────────────────────────────────────────────────────────
# Client — Next.js (baked in at image build time)
# ─────────────────────────────────────────────────────────
# Must match STORAGE_PUBLIC_URL above
NEXT_PUBLIC_STORAGE_PUBLIC_URL=https://TODO.r2.dev
