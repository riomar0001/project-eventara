# =============================================================================
# Eventara — Monorepo .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
.env
.env.local
.env.test
.env.production
.env.*.local

# -----------------------------------------------------------------------------
# Python / FastAPI (server/)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
venv/
.venv/
ENV/
env/
.conda/

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
test_results/
coverage.xml
pytest.xml
test_*.db

# Alembic
alembic/__pycache__/
alembic/*.pyc
alembic/*.pyo
alembic/versions/*.tmp
alembic/versions/*.bak

# FastAPI generated
openapi.json
redoc-static.html

# Database
*.db
*.sqlite3

# uv
.python-version

# -----------------------------------------------------------------------------
# Node.js / Next.js (client/)
# -----------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
.next/
out/

# Build output
/client/build

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
logs/
uvicorn.log
debug.log
app.log

# -----------------------------------------------------------------------------
# IDE / Editors
# -----------------------------------------------------------------------------
.idea/
*.swp
*.swo
.vim/
.emacs.d/

# -----------------------------------------------------------------------------
# OS
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
.claude/
.ruff_cache/
skills-lock.json
.agents/
eventara_key.pem