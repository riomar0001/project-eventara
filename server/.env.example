# Eventara API — local development settings.
# Copy to server/.env. On AWS these values come from Terraform (infra/terraform).
APP_NAME=Eventara
DEBUG=True

# PostgreSQL (asyncpg driver). On RDS append ?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/eventara_db
# Lambda runs one request per container: use DB_POOL_SIZE=1, DB_MAX_OVERFLOW=0 there.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# JWT secrets — generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_ACCESS_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=
JWT_VERIFICATION_TOKEN_SECRET=
ADMISSION_TOKEN_SECRET=
# Durations: 30s, 15m, 3h, 7d, or bare minutes
ACCESS_TOKEN_EXPIRATION=3h
REFRESH_TOKEN_EXPIRATION=7d
VERIFICATION_TOKEN_EXPIRATION=24h

# Redis — rate limits, OTPs, reset tokens and the dead-job store.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=False

# Background jobs. Leave JOB_QUEUE_URL empty to run jobs and schedules
# in-process; set it to an SQS queue URL to use SQS (as on AWS).
JOB_QUEUE_URL=
JOB_MAX_TRIES=3
JOB_RETRY_BASE_SECONDS=30

# Email. MAIL_PROVIDER=smtp (any SMTP server) or ses (Amazon SES, IAM credentials).
MAIL_PROVIDER=smtp
MAIL_FROM=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=False
MAIL_USER=
MAIL_PASS=
SES_REGION=

# CORS_ORIGIN: participant site base URL used in email links (/verify, /reset-password).
# ALLOWED_ORIGINS: comma-separated origins allowed to call the API cross-origin.
# "*" is accepted only while DEBUG=True.
CORS_ORIGIN=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# System administrator created by seeds/system_admin.py
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Object storage. On AWS leave ENDPOINT and the key pair empty to use the IAM role.
# For R2/MinIO set STORAGE_ENDPOINT plus both keys.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=
STORAGE_PUBLIC_URL=
